# -*-mode:gitignore-*- vim:ft=gitignore

# ~/.local/share/chezmoi/.chezmoiignore
# =============================================================================
# Read by chezmoi when chosing repository files to copy to home directory.
#
# This list defines globs to ignore, and supports Go's text/template language.
# See https://www.chezmoi.io/reference/special-files/chezmoiignore/

# Repository files that have no place on actual machines.
README.md
LICENSE
scripts

# Transient backups (e.g. pre-reset copies of agent prompt files) live in
# the repo's gitignored tmp/ dir; they must never deploy into ~/tmp.
tmp/*.bak

# GitHub Actions workflows and CI prompts are repo-internal only;
# chezmoi should never deploy them into ~/.
.github

# .factory/skills/review-guidelines is repo-internal CI config for the
# droid-action (review comment guidelines). chezmoi already ignores
# literal dot-directories, but listing it here documents the intent
# alongside .github above. The chezmoi-managed ~/.factory/ comes from
# private_dot_factory/ — this entry does NOT affect that.
.factory/skills/review-guidelines

# Ignore non-macOS files.
{{ if ne .chezmoi.os "darwin" -}}
Library/Preferences
{{- end }}

# Ignore the mprime service unless this is Linux with the mprime Flatpak installed.
{{ if or (ne .chezmoi.os "linux") (not (and (lookPath "flatpak") (contains "org.mersenne.mprime" (output (lookPath "flatpak") "list" "--app" "--columns=application")))) -}}
.config/systemd/user/mprime.service
{{- end }}

# Files managed by chezmoi_modify_manager: *.src.ini are the source-of-truth
# inputs for modify_ scripts and must never be deployed into ~/.
**/*.src.ini

# mprime's ~/.var tree is managed only on GIMPS machines, opted in via
# `gimps = true` in the machine's chezmoi config [data]. Default is off;
# the hasKey guard also defaults machines with an older config (no gimps
# key) to off. The whole .var tree is gated (not just the mprime app dir)
# so non-GIMPS machines never get empty ~/.var directories created.
{{- $gimps := false }}
{{- if hasKey . "gimps" }}{{ $gimps = .gimps }}{{ end }}
{{- if not $gimps }}
.var
{{- end }}

# Agent prompt files that gentle-ai rewrites (marker-delimited sections).
# On machines with `gentleAi = true`, chezmoi seeds these targets once
# (see docs/work-dotfiles.md "gentle-ai coexistence") and then ignores
# them, so `chezmoi apply` never clobbers gentle-ai's injected sections
# and `gentle-ai sync` never re-drifts them against the source. Default
# is off (hasKey guard): machines without gentle-ai keep the files fully
# chezmoi-managed.
{{- $gentleAi := false }}
{{- if hasKey . "gentleAi" }}{{ $gentleAi = .gentleAi }}{{ end }}
{{- if $gentleAi }}
.claude/CLAUDE.md
.config/opencode/AGENTS.md
{{- end }}

# .pypirc holds work PyPI credentials and is stored age-encrypted
# (docs/work-dotfiles.md Pattern 4). Non-work machines have no age key
# and must never attempt decryption.
{{- if not .work }}
.pypirc
{{- end }}

# Ignore iTerm2 preferences unless explicitly enabled.
{{- if not .iterm2 }}
Library/Preferences/com.googlecode.iterm2.plist
{{- end }}

# ignore non-Windows files.
{{ if ne .chezmoi.os "windows" -}}
.config/starship/scripts/drcli.ps1
{{- end }}

# Ignore the POSIX drcli script on Windows.
{{ if eq .chezmoi.os "windows" -}}
.config/starship/scripts/drcli.sh
{{- end }}

# Ignore work files.
# Patterns match target paths, not source paths (hence .claude, not dot_claude).
{{- if not .work }}
workspace/DataRobot
.claude/skills/tech-debt-epic
.shellrc.d/06-work-env.sh
{{- end }}
