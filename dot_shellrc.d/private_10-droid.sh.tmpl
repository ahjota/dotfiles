# ~/.shellrc.d/droid.sh
# Smart droid wrapper: redirects to nearest trusted folder (or the
# configured scratchpad), unless running a subcommand or an explicit
# --cwd is given.
#
# Portability: sourced by both bash (3.2 on stock macOS) and zsh.
# Avoids associative arrays — bash 3.2 lacks `declare -A` and zsh's
# hash subscript semantics differ from bash's, which silently broke
# the trusted-folder lookup. Uses a newline-delimited list + `case`
# instead, which behaves identically across both shells.
#
# History: originally written on Fedora, where /bin/bash is 4+, so
# associative arrays worked. Kept portable here because macOS ships
# bash 3.2 as /bin/bash (GPLv3) and the user shell is zsh.

# Known subcommands that should NOT be redirected (always run in CWD)
_droid_subcommands="exec daemon search find update mcp plugin computer help"

_droid_smart() {
    # 1. If user explicitly passed --cwd, pass through untouched
    local arg
    for arg in "$@"; do
        if [[ "$arg" == "--cwd" || "$arg" == --cwd=* ]]; then
            command droid "$@"
            return $?
        fi
    done

    # 2. If first positional arg is a subcommand, pass through (no redirect)
    local first_positional=""
    for arg in "$@"; do
        if [[ "$arg" != -* ]]; then
            first_positional="$arg"
            break
        fi
    done
    local sub
    for sub in $_droid_subcommands; do
        if [[ "$first_positional" == "$sub" ]]; then
            command droid "$@"
            return $?
        fi
    done

    # 3. Read trusted folders from settings.json into a newline-delimited
    #    string of canonical (realpath-resolved) absolute paths. Using a
    #    plain string + `case` match avoids the zsh/bash associative-array
    #    incompatibilities that previously broke the lookup.
    local _trusted=""
    if [[ -f "$HOME/.factory/settings.json" ]]; then
        local t rt
        while IFS= read -r t; do
            [[ -z "$t" ]] && continue
            rt=$(realpath "$t" 2>/dev/null || echo "$t")
            _trusted="${_trusted}${rt}"$'\n'
        done < <(jq -r '.trustedFolders | keys[]?' "$HOME/.factory/settings.json" 2>/dev/null)
    fi

    # 4. Walk up from PWD to find nearest trusted ancestor. `case` on the
    #    delimited string matches regardless of whether the shell is bash
    #    or zsh.
    local target=""
    local dir
    dir=$(realpath "$PWD" 2>/dev/null || echo "$PWD")
    while [[ -n "$dir" && "$dir" != "/" ]]; do
        case "${_trusted}" in
            *"${dir}"$'\n'*) target="$dir"; break ;;
        esac
        dir=$(dirname "$dir")
    done

    # 5. No trusted ancestor → default to scratchpad.
    #    Fallback path comes from chezmoi data (chezmoi.toml ->
    #    data.scratchpad). It may arrive as `~/...` (literal tilde), so
    #    expand the tilde before resolving realpath; otherwise realpath
    #    treats `~` as a literal directory name.
    if [[ -z "$target" ]]; then
        target={{ .scratchpad | quote }}
        target="${target/#\~/$HOME}"
        target=$(realpath "$target" 2>/dev/null || echo "$target")
    fi

    command droid --cwd "$target" "$@"
}

droid()      { _droid_smart "$@"; }
dr()         { _droid_smart "$@"; }
droid-here() { command droid "$@"; }
